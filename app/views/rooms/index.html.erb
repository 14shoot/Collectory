<div class="container mt-4">
    <h2 class="mb-4">DM一覧</h2>
  
    <% @rooms.each do |room| %>
      <% other_user = room.users.find { |user| user != current_user } %>
      <% last_message = room.messages.order(created_at: :desc).first %>
  
      <%= link_to room_path(room), class: "text-decoration-none text-dark" do %>
        <div class="card mb-3 p-3">
  
          <div class="d-flex align-items-center">
            <% if other_user&.profile_image&.attached? %>
              <%= image_tag other_user.profile_image,
                            size: "50x50",
                            class: "rounded-circle me-3" %>
            <% else %>
              <%= image_tag "no_image.svg",
                            size: "50x50",
                            class: "rounded-circle me-3" %>
            <% end %>
  
            <div>
              <strong><%= other_user&.name %></strong>
  
              <% if last_message %>
                <p class="mb-0 text-muted">
                  <%= last_message.content %>
                </p>
  
                <small class="text-muted">
                  <%= last_message.created_at.strftime("%Y/%m/%d %H:%M") %>
                </small>
              <% else %>
                <p class="mb-0 text-muted">
                  まだメッセージはありません
                </p>
              <% end %>
            </div>
          </div>
  
        </div>
      <% end %>
    <% end %>
  </div>