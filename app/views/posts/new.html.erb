<div class="cover-new">
  <div class="container py-5">

    <div class="new-post-card mx-auto">

      <h1 class="text-center mb-4">新規投稿</h1>

      <% if @post.errors.any? %>
        <div class="alert alert-danger">
          <p class="mb-2">
            <%= @post.errors.count %>件のエラーが発生しました
          </p>

          <% @post.errors.full_messages.each do |message| %>
            <p class="mb-1"><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @post, local: true do |f| %>

        <!-- カテゴリー -->
        <div class="mb-4">
          <%= f.label :category_id, "カテゴリー", class: "form-label" %>

          <%= f.collection_select :category_id,
              @categories,
              :id,
              :name,
              { prompt: "選択してください" },
              { class: "form-select" } %>
        </div>

        <!-- 商品名 -->
        <div class="mb-4">
          <%= f.label :body, "商品名", class: "form-label" %>

          <%= f.text_field :body,
              class: "form-control",
              placeholder: "商品名を入力してください" %>
        </div>

        <!-- 位置情報 -->
        <div class="mb-4">
          <%= f.label :location, "位置情報", class: "form-label" %>

          <%= f.text_field :location,
              class: "form-control",
              placeholder: "例：東京都杉並区" %>
        </div>

        <!-- 画像 -->
        <div class="mb-4">
          <%= f.label :image, "画像", class: "form-label" %>

          <%= f.file_field :image,
              class: "form-control" %>
        </div>

        <!-- 投稿ボタン -->
        <div class="d-flex gap-2">
          <%= f.button "投稿する",
              name: "post[status]",
              value: "published",
              class: "btn btn-success flex-fill" %>
        
          <%= f.button "下書き保存",
              name: "post[status]",
              value: "draft",
              class: "btn btn-outline-secondary flex-fill" %>
        </div>
        </div>
      <% end %>

    </div>

  </div>
</div>