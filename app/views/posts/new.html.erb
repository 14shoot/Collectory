<h1>新規投稿</h1>

<% if @post.errors.any? %>
  <h2>エラーがあります</h2>

  <% @post.errors.full_messages.each do |message| %>
    <p><%= message %></p>
  <% end %>
<% end %>

<%= form_with model: @post, local: true do |f| %>

  <h4>カテゴリー</h4>
  <%= f.collection_select :category_id, @categories, :id, :name,
      { prompt: "選択してください" } %>

  <h4>商品名</h4>
  <%= f.text_field :body %>

  <h4>場所</h4>
  <%= f.text_field :location %>

  <%= f.submit "投稿する" %>

<% end %>