
<h1>投稿一覧</h1>

<% @posts.each do |post| %>
  <p>投稿物</p>
  <p>商品名：<%= post.body %></p>
  <p>場所：<%= post.location %></p>
  <p>画像</p>
  <% if post.image.attached? %>
    <%= image_tag post.image.variant(resize_to_limit: [100, 100]) %>
  <% end %>
  <span><%= link_to "詳細", post_path(post) %></span>
<% end %>