<div class="cover-show">
  <div class="container py-5">

    <h1 class="text-center mb-5">投稿編集</h1>

    <% if @post.errors.any? %>
      <div class="alert alert-danger">
        <%= @post.errors.count %>件のエラーが発生しました

        <% @post.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <div class="row justify-content-center">

      <div class="col-md-6">

        <div class="post-card">

          <%= form_with model: @post, local: true do |f| %>

            <!-- 現在の画像 -->
            <% if @post.image.attached? %>
              <%= image_tag @post.image, class: "post-detail" %>
            <% end %>


            <!-- 画像変更 -->
            <div class="post-info-item">
              <h3 class="post-info-title">画像</h3>

              <%= f.file_field :image,
                  class: "form-control" %>

              <p class="mt-2 mb-0">
                変更する場合のみ画像を選択してください
              </p>
            </div>


            <!-- 商品情報 -->
            <div class="post-info-item">
              <h3 class="post-info-title">商品情報</h3>

              <%= f.text_field :body,
                  class: "form-control" %>
            </div>


            <!-- カテゴリー -->
            <div class="post-info-item">
              <h3 class="post-info-title">カテゴリー</h3>

              <%= f.collection_select :category_id,
                  @categories,
                  :id,
                  :name,
                  { prompt: "選択してください" },
                  { class: "form-control" } %>
            </div>


            <!-- 位置情報 -->
            <div class="post-info-item">
              <h3 class="post-info-title">位置情報</h3>

              <%= f.text_field :location,
                  class: "form-control" %>
            </div>


            <!-- 投稿日 -->
            <div class="post-info-item">
              <h3 class="post-info-title">投稿日</h3><p class="post-info-text"><%= @post.created_at.strftime("%Y/%m/%d %H:%M") %></p>
            </div>



            <!-- 更新ボタン -->
            <div class="post-info-actions">

            <% if @post.draft? %>

              <%= f.button "公開する",
                name: "post[status]",
                value: "published",
                class: "btn btn-success" %>

              <%= f.button "下書きのまま更新",
                name: "post[status]",
                value: "draft",
                class: "btn btn-outline-secondary" %>

              <% else %>

                <%= f.submit "更新する",
                  class: "btn btn-success" %>

              <% end %>

              <%= link_to "キャンセル",
                drafts_posts_path,
                class: "btn btn-outline-secondary" %>

            </div>

          <% end %>

        </div>

      </div>

    </div>

  </div>
</div>